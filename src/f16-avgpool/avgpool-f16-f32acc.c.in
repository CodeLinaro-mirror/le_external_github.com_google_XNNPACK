$assert ARCH in ("scalar", "wasmrelaxedsimd", "neonfp16", "avx512skx", "hvx")
$SIMD_ARCH = {
$  "neonfp16": "neon",
$  "avx512skx": "avx512f",
$}.get(ARCH, ARCH)
$SIMD_SIZE = {
$  "scalar": 1,
$  "wasmrelaxedsimd": 4,
$  "neonfp16": 4,
$  "avx512skx": 16,
$  "hvx": 32,
$}[ARCH]
#include <assert.h>
#include <stddef.h>
#include <stdint.h>

#include "src/xnnpack/common.h"
#include "src/xnnpack/math.h"
#include "src/xnnpack/microparams.h"
#include "src/xnnpack/simd/f32-${SIMD_ARCH}.h"
$if ARCH == "wasmrelaxedsimd":
  #undef XNN_SIMD_HAS_NATIVE_FMA
  #include "src/xnnpack/simd/f16-wasmrelaxedsimd.h"
$elif ARCH == "scalar":
  #include "src/xnnpack/simd/f16-${ARCH}.h"


static XNN_INLINE xnn_simd_f32_t xnn_loadu_f16_f32(const xnn_float16* input) {
  $if ARCH == "wasmrelaxedsimd":
    return xnn_cvt_f32_f16(wasm_v128_load64_zero(input));
  $else:
    return xnn_cvt_f32_f16(xnn_loadu_f16(input));
}

static XNN_INLINE xnn_simd_f32_t xnn_load_sum9_f16_f32(
    const xnn_float16* i0, const xnn_float16* i1, const xnn_float16* i2,
    const xnn_float16* i3, const xnn_float16* i4, const xnn_float16* i5,
    const xnn_float16* i6, const xnn_float16* i7, const xnn_float16* i8,
    uintptr_t idx) {
  $for K in range(9):
    const xnn_simd_f32_t vi${K} = xnn_loadu_f16_f32(
        (const xnn_float16*) ((uintptr_t) i${K} + idx));
  const xnn_simd_f32_t vsum018 = xnn_add_f32(xnn_add_f32(vi0, vi1), vi8);
  const xnn_simd_f32_t vsum23 = xnn_add_f32(vi2, vi3);
  const xnn_simd_f32_t vsum45 = xnn_add_f32(vi4, vi5);
  const xnn_simd_f32_t vsum67 = xnn_add_f32(vi6, vi7);
  return xnn_add_f32(
      xnn_add_f32(vsum23, vsum45), xnn_add_f32(vsum018, vsum67));
}

static XNN_INLINE void xnn_store_f32_f16(
    xnn_float16* output, xnn_simd_f32_t value) {
  $if ARCH == "wasmrelaxedsimd":
    wasm_v128_store64_lane(output, xnn_cvt_f16_f32(value), 0);
  $elif ARCH == "hvx":
    xnn_store_tail_f16(output, xnn_cvt_f16_f32(value), xnn_simd_size_f32);
  $else:
    xnn_storeu_f16(output, xnn_cvt_f16_f32(value));
}

$if SIMD_SIZE > 1:
  static XNN_INLINE xnn_simd_f32_t xnn_load_tail_sum9_f16_f32(
      const xnn_float16* i0, const xnn_float16* i1, const xnn_float16* i2,
      const xnn_float16* i3, const xnn_float16* i4, const xnn_float16* i5,
      const xnn_float16* i6, const xnn_float16* i7, const xnn_float16* i8,
      uintptr_t idx, size_t elements) {
    $if ARCH == "avx512skx":
      const __mmask16 vmask =
          _cvtu32_mask16((uint32_t) ((UINT32_C(1) << elements) - UINT32_C(1)));
      $for K in range(9):
        const xnn_simd_f32_t vi${K} = _mm512_cvtph_ps(_mm256_maskz_loadu_epi16(
            vmask, (const xnn_float16*) ((uintptr_t) i${K} + idx)));
    $else:
      $for K in range(9):
        const xnn_simd_f32_t vi${K} = xnn_cvt_f32_f16(xnn_load_tail_f16(
            (const xnn_float16*) ((uintptr_t) i${K} + idx), elements));
    const xnn_simd_f32_t vsum018 = xnn_add_f32(xnn_add_f32(vi0, vi1), vi8);
    const xnn_simd_f32_t vsum23 = xnn_add_f32(vi2, vi3);
    const xnn_simd_f32_t vsum45 = xnn_add_f32(vi4, vi5);
    const xnn_simd_f32_t vsum67 = xnn_add_f32(vi6, vi7);
    return xnn_add_f32(
        xnn_add_f32(vsum23, vsum45), xnn_add_f32(vsum018, vsum67));
  }

  static XNN_INLINE void xnn_store_tail_f32_f16(
      xnn_float16* output, xnn_simd_f32_t value, size_t elements) {
    $if ARCH == "avx512skx":
      const __mmask16 vmask =
          _cvtu32_mask16((uint32_t) ((UINT32_C(1) << elements) - UINT32_C(1)));
      _mm256_mask_storeu_epi16(
          output, vmask,
          _mm512_cvtps_ph(value, _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC));
    $else:
      xnn_store_tail_f16(output, xnn_cvt_f16_f32(value), elements);
  }

$if ARCH == "avx512skx":
  // Remainders of <= 8 channels use YMM because masked-off ZMM lanes
  // consume FP throughput on double-pumped AVX-512 cores (Zen 4 / Zen 5).
  static XNN_INLINE __m256 xnn_load_tail8_sum9_f16_f32(
      const xnn_float16* i0, const xnn_float16* i1, const xnn_float16* i2,
      const xnn_float16* i3, const xnn_float16* i4, const xnn_float16* i5,
      const xnn_float16* i6, const xnn_float16* i7, const xnn_float16* i8,
      uintptr_t idx, size_t elements) {
    const __mmask8 vmask =
        _cvtu32_mask8((uint32_t) ((UINT32_C(1) << elements) - UINT32_C(1)));
    $for K in range(9):
      const __m256 vi${K} = _mm256_cvtph_ps(_mm_maskz_loadu_epi16(
          vmask, (const xnn_float16*) ((uintptr_t) i${K} + idx)));
    const __m256 vsum018 = _mm256_add_ps(_mm256_add_ps(vi0, vi1), vi8);
    const __m256 vsum23 = _mm256_add_ps(vi2, vi3);
    const __m256 vsum45 = _mm256_add_ps(vi4, vi5);
    const __m256 vsum67 = _mm256_add_ps(vi6, vi7);
    return _mm256_add_ps(
        _mm256_add_ps(vsum23, vsum45), _mm256_add_ps(vsum018, vsum67));
  }

  static XNN_INLINE void xnn_store_tail8_f32_f16(
      xnn_float16* output, __m256 value, size_t elements) {
    const __mmask8 vmask =
        _cvtu32_mask8((uint32_t) ((UINT32_C(1) << elements) - UINT32_C(1)));
    _mm_mask_storeu_epi16(
        output, vmask,
        _mm256_cvtps_ph(value, _MM_FROUND_TO_NEAREST_INT | _MM_FROUND_NO_EXC));
  }

static XNN_INLINE void xnn_avgpool_finalize_channels(
    size_t channels,
    const xnn_float16* i0, const xnn_float16* i1, const xnn_float16* i2,
    const xnn_float16* i3, const xnn_float16* i4, const xnn_float16* i5,
    const xnn_float16* i6, const xnn_float16* i7, const xnn_float16* i8,
    const float* acc,
    xnn_simd_f32_t vscale, xnn_simd_f32_t vmin, xnn_simd_f32_t vmax,
    xnn_float16* output) {
  uintptr_t idx = 0;
  for (; channels >= ${SIMD_SIZE}; channels -= ${SIMD_SIZE}) {
    xnn_simd_f32_t vacc = xnn_load_sum9_f16_f32(
        i0, i1, i2, i3, i4, i5, i6, i7, i8, idx);
    if (acc != NULL) {
      vacc = xnn_add_f32(
          vacc, xnn_loadu_f32((const float*) ((uintptr_t) acc + idx * 2)));
    }
    vacc = xnn_mul_f32(vacc, vscale);
    vacc = xnn_max_f32(vacc, vmin);
    vacc = xnn_min_f32(vacc, vmax);
    xnn_store_f32_f16((xnn_float16*) ((uintptr_t) output + idx), vacc);
    idx += ${SIMD_SIZE} * sizeof(xnn_float16);
  }
  $if ARCH == "avx512skx":
    if (channels > 8) {
      xnn_simd_f32_t vacc = xnn_load_tail_sum9_f16_f32(
          i0, i1, i2, i3, i4, i5, i6, i7, i8, idx, channels);
      if (acc != NULL) {
        vacc = xnn_add_f32(
            vacc, xnn_loadu_f32((const float*) ((uintptr_t) acc + idx * 2)));
      }
      vacc = xnn_mul_f32(vacc, vscale);
      vacc = xnn_max_f32(vacc, vmin);
      vacc = xnn_min_f32(vacc, vmax);
      xnn_store_tail_f32_f16(
          (xnn_float16*) ((uintptr_t) output + idx), vacc, channels);
    } else if (channels != 0) {
      __m256 vacc = xnn_load_tail8_sum9_f16_f32(
          i0, i1, i2, i3, i4, i5, i6, i7, i8, idx, channels);
      if (acc != NULL) {
        vacc = _mm256_add_ps(
            vacc, _mm256_loadu_ps((const float*) ((uintptr_t) acc + idx * 2)));
      }
      vacc = _mm256_mul_ps(vacc, _mm512_castps512_ps256(vscale));
      vacc = _mm256_max_ps(vacc, _mm512_castps512_ps256(vmin));
      vacc = _mm256_min_ps(vacc, _mm512_castps512_ps256(vmax));
      xnn_store_tail8_f32_f16(
          (xnn_float16*) ((uintptr_t) output + idx), vacc, channels);
    }
  $elif SIMD_SIZE > 1:
    if (channels != 0) {
      xnn_simd_f32_t vacc = xnn_load_tail_sum9_f16_f32(
          i0, i1, i2, i3, i4, i5, i6, i7, i8, idx, channels);
      if (acc != NULL) {
        vacc = xnn_add_f32(
            vacc, xnn_loadu_f32((const float*) ((uintptr_t) acc + idx * 2)));
      }
      vacc = xnn_mul_f32(vacc, vscale);
      vacc = xnn_max_f32(vacc, vmin);
      vacc = xnn_min_f32(vacc, vmax);
      xnn_store_tail_f32_f16(
          (xnn_float16*) ((uintptr_t) output + idx), vacc, channels);
    }
}


void xnn_f16_f32acc_avgpool_minmax_ukernel_9p__${ARCH}_u${SIMD_SIZE}(
    size_t output_pixels,
    size_t kernel_elements,
    size_t channels,
    const xnn_float16** input,
    size_t input_offset,
    size_t input_pixel_stride,
    const xnn_float16* zero,
    const xnn_float16* multiplier,
    xnn_float16* output,
    size_t input_increment,
    size_t output_increment,
    const struct xnn_f16_scaleminmax_params* restrict params)
{
  assert(output_pixels != 0);
  assert(channels != 0);
  assert(xnn_simd_size_f32 == ${SIMD_SIZE});

  const xnn_simd_f32_t vmin =
      xnn_set1_f32(xnn_float16_to_float(params->scalar.min));
  const xnn_simd_f32_t vmax =
      xnn_set1_f32(xnn_float16_to_float(params->scalar.max));
  XNN_FORCE_REALIZATION(vmin);
  XNN_FORCE_REALIZATION(vmax);

  xnn_simd_f32_t vscale =
      xnn_set1_f32(xnn_float16_to_float(params->scalar.scale));

  if XNN_LIKELY(kernel_elements <= 9) {
    do {
      if (multiplier != NULL) {
        vscale = xnn_set1_f32(xnn_float16_to_float(*multiplier++));
      }

      const xnn_float16** i = input;
      $for K in range(9):
        const xnn_float16* i${K} = ${K} < kernel_elements ? *i++ : zero;
        assert(i${K} != NULL);
        if XNN_UNPREDICTABLE(i${K} != zero) {
          i${K} = (const xnn_float16*) ((uintptr_t) i${K} + input_offset);
        }

      xnn_avgpool_finalize_channels(
          channels, i0, i1, i2, i3, i4, i5, i6, i7, i8, /*acc=*/NULL,
          vscale, vmin, vmax, output);

      input = (const xnn_float16**) ((uintptr_t) input + input_increment);
      input_offset += input_pixel_stride;
      output = (xnn_float16*) ((uintptr_t) output + output_increment);
    } while (--output_pixels != 0);
  } else {
    // Accumulate in L1-resident FP32 strips so kernel_elements > 9 preserves
    // full FP32 precision without repeating pointer setup per SIMD vector.
    $if ARCH == "hvx":
      XNN_ALIGN(128) float acc[256];
    $else:
      XNN_ALIGN(16) float acc[256];

    do {
      if (multiplier != NULL) {
        vscale = xnn_set1_f32(xnn_float16_to_float(*multiplier++));
      }

      size_t c_rem = channels;
      uintptr_t base_idx = 0;
      do {
        const size_t strip_c = min(c_rem, 256);
        const xnn_float16** i = input;
        size_t k = kernel_elements;

        for (; k > 9; k -= 9) {
          $for K in range(9):
            const xnn_float16* i${K} = *i++;
            assert(i${K} != NULL);
            if XNN_UNPREDICTABLE(i${K} != zero) {
              i${K} = (const xnn_float16*) ((uintptr_t) i${K} + input_offset);
            }
            i${K} = (const xnn_float16*) ((uintptr_t) i${K} + base_idx);

          uintptr_t idx = 0;
          size_t sc = strip_c;
          for (; sc >= ${SIMD_SIZE}; sc -= ${SIMD_SIZE}) {
            xnn_simd_f32_t vacc = xnn_load_sum9_f16_f32(
                i0, i1, i2, i3, i4, i5, i6, i7, i8, idx);
            if (k != kernel_elements) {
              vacc = xnn_add_f32(
                  vacc,
                  xnn_loadu_f32((const float*) ((uintptr_t) acc + idx * 2)));
            }
            xnn_storeu_f32((float*) ((uintptr_t) acc + idx * 2), vacc);
            idx += ${SIMD_SIZE} * sizeof(xnn_float16);
          }
          $if ARCH == "avx512skx":
            if (sc > 8) {
              xnn_simd_f32_t vacc = xnn_load_tail_sum9_f16_f32(
                  i0, i1, i2, i3, i4, i5, i6, i7, i8, idx, sc);
              if (k != kernel_elements) {
                vacc = xnn_add_f32(
                    vacc,
                    xnn_loadu_f32((const float*) ((uintptr_t) acc + idx * 2)));
              }
              xnn_storeu_f32((float*) ((uintptr_t) acc + idx * 2), vacc);
            } else if (sc != 0) {
              __m256 vacc = xnn_load_tail8_sum9_f16_f32(
                  i0, i1, i2, i3, i4, i5, i6, i7, i8, idx, sc);
              if (k != kernel_elements) {
                vacc = _mm256_add_ps(
                    vacc,
                    _mm256_loadu_ps((const float*) ((uintptr_t) acc + idx * 2)));
              }
              _mm256_storeu_ps((float*) ((uintptr_t) acc + idx * 2), vacc);
            }
          $elif SIMD_SIZE > 1:
            if (sc != 0) {
              xnn_simd_f32_t vacc = xnn_load_tail_sum9_f16_f32(
                  i0, i1, i2, i3, i4, i5, i6, i7, i8, idx, sc);
              if (k != kernel_elements) {
                vacc = xnn_add_f32(
                    vacc,
                    xnn_loadu_f32((const float*) ((uintptr_t) acc + idx * 2)));
              }
              xnn_storeu_f32((float*) ((uintptr_t) acc + idx * 2), vacc);
            }
        }

        $for K in range(9):
          const xnn_float16* i${K} = ${K} < k ? *i++ : zero;
          assert(i${K} != NULL);
          if XNN_UNPREDICTABLE(i${K} != zero) {
            i${K} = (const xnn_float16*) ((uintptr_t) i${K} + input_offset);
          }
          i${K} = (const xnn_float16*) ((uintptr_t) i${K} + base_idx);

        xnn_avgpool_finalize_channels(
            strip_c, i0, i1, i2, i3, i4, i5, i6, i7, i8, acc,
            vscale, vmin, vmax,
            (xnn_float16*) ((uintptr_t) output + base_idx));

        base_idx += strip_c * sizeof(xnn_float16);
        c_rem -= strip_c;
      } while (c_rem != 0);

      input = (const xnn_float16**) ((uintptr_t) input + input_increment);
      input_offset += input_pixel_stride;
      output = (xnn_float16*) ((uintptr_t) output + output_increment);
    } while (--output_pixels != 0);
  }
}
